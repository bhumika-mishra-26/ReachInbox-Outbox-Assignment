# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL / Neon DB)
DATABASE_URL=postgresql://user:password@ep-raspy-scene-b5xq9r9i.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&connect_timeout=30

# Redis (BullMQ, Upstash / Local Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Elasticsearch (Cloud / Local)
ELASTICSEARCH_NODE=https://my-elasticsearch-project.es.us-central1.gcp.elastic.cloud:443
ELASTICSEARCH_API_KEY=your_elasticsearch_api_key_here

# Auth & Sessions
SESSION_SECRET=reachinbox_super_secret_session_key_12345
JWT_SECRET=reachinbox_jwt_secret_key_67890

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# Slack OAuth
SLACK_CLIENT_ID=your_slack_client_id_here
SLACK_CLIENT_SECRET=your_slack_client_secret_here
SLACK_REDIRECT_URI=http://localhost:5000/api/slack/callback

# Worker Configuration
WORKER_CONCURRENCY=5
DEFAULT_MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_DEFAULT=200

# SMTP / Gmail Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user@gmail.com
SMTP_PASS=your_smtp_app_password
GMAIL_USER=your_gmail_user@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password

# S3 Attachment Storage (Neon DB / AWS S3)
AWS_ENDPOINT_URL_S3=https://br-polished-brook-b5mutfrs.storage.c-7.us-east-2.aws.neon.tech
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-2
S3_BUCKET_NAME=attachments
