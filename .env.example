# # Server Configuration
# PORT=5000
# NODE_ENV=development
# FRONTEND_URL=http://localhost:5173

# # Database (PostgreSQL)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox?schema=public

# # Redis (BullMQ & Rate Limiter & Sessions)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# # Elasticsearch
# ELASTICSEARCH_NODE=http://localhost:9200

# # Auth & Sessions
# SESSION_SECRET=reachinbox_super_secret_session_key_12345
# JWT_SECRET=reachinbox_jwt_secret_key_67890

# # Google OAuth
# GOOGLE_CLIENT_ID=your_google_client_id_here
# GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# # Slack OAuth
# SLACK_CLIENT_ID=your_slack_client_id_here
# SLACK_CLIENT_SECRET=your_slack_client_secret_here
# SLACK_REDIRECT_URI=http://localhost:5000/api/slack/callback

# # Worker Configuration
# WORKER_CONCURRENCY=5
# DEFAULT_MIN_DELAY_BETWEEN_EMAILS_MS=2000
# MAX_EMAILS_PER_HOUR_DEFAULT=200
